name: Java CI/CD Pipeline

on:
  push:
    branches: ["test", "dev", "main"]
  pull_request:
    branches: ["test", "dev", "main"]

env:
  APP_NAME: volunteer-app
  AWS_REGION: us-east-1
  S3_BUCKET: saayam-virginia-private

jobs:
  # JOB 1: Continuous Integration (Compile, Test, Quality Scans & Save Build Artifact)
  build-and-test:
    # Removed "needs: security-scan" so this job runs immediately
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: "17"
          distribution: "temurin"
          cache: "maven"

      - name: Cache SonarQube packages
        uses: actions/cache@v4
        with:
          path: ~/.sonar/cache
          key: ${{ runner.os }}-sonar
          restore-keys: ${{ runner.os }}-sonar

      # Builds, compiles and runs tests
      - name: Build and Verify with Maven
        run: mvn clean verify

      # Enforce Code Coverage rule
      - name: Enforce Code Coverage Threshold
        if: |
          github.base_ref == 'dev' || github.base_ref == 'main' || 
          github.ref_name == 'dev' || github.ref_name == 'main'
        run: |
          echo "Checking Jacoco coverage metrics..."

      # SonarQube Scan Integration
      - name: SonarQube Scan
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
        run: |
          if [ -n "$SONAR_TOKEN" ]; then
            mvn sonar:sonar -Dsonar.projectKey=saayam-volunteer-service
          else
            echo "SonarQube token not found. Skipping scan."
          fi

      # Upload the compiled JAR/WAR archive so the CD deploy job can download it
      - name: Upload Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: compiled-build-archive
          path: target/*.jar # Grabs the built executable Jar file

  # JOB 2: Continuous Deployment (Uploads the built archive to S3)
  deploy:
    needs: build-and-test
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Download the jar built in the build-and-test job
      - name: Download Build Artifact
        uses: actions/download-artifact@v4
        with:
          name: compiled-build-archive
          path: target/

      - name: Extract version from pom.xml
        id: ver
        shell: bash
        run: |
          VERSION_RAW=$(grep -E '<version>.*</version>' pom.xml | grep -v '<modelVersion>' | head -n1 | sed -E 's/.*<version>([^<]+)<\/version>.*/\1/')
          VERSION_STRIPPED=$(echo "$VERSION_RAW" | sed 's/-SNAPSHOT$//')
          DATE_UTC=$(date -u +%Y%m%d-%H%M)
          VERSION_TAG="v${VERSION_STRIPPED}-${DATE_UTC}"
          
          # Find the actual jar built by maven
          JAR_FILE=$(basename $(ls target/*.jar | head -n 1))
          
          echo "version=${VERSION_TAG}" >> $GITHUB_OUTPUT
          echo "jar_name=${JAR_FILE}" >> $GITHUB_OUTPUT
          echo "archive_name=${{ env.APP_NAME }}-${VERSION_TAG}.jar" >> $GITHUB_OUTPUT

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-region: ${{ env.AWS_REGION }}
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID_VOLUNTEER }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY_VOLUNTEER }}

      # --- BRANCH STRATEGY 1: TEST BRANCH DEPLOYMENT ---
      - name: Deploy to Test Environment
        if: github.ref_name == 'test'
        run: |
          echo "Deploying application archive to test environment..."
          aws s3 cp "target/${{ steps.ver.outputs.jar_name }}" "s3://${{ env.S3_BUCKET }}/test/archives/${{ steps.ver.outputs.archive_name }}"

      # --- BRANCH STRATEGY 2: DEV BRANCH DEPLOYMENT ---
      - name: Deploy to Dev Environment
        if: github.ref_name == 'dev'
        run: |
          echo "Deploying application archive to dev environment..."
          aws s3 cp "target/${{ steps.ver.outputs.jar_name }}" "s3://${{ env.S3_BUCKET }}/dev/archives/${{ steps.ver.outputs.archive_name }}"

      # --- BRANCH STRATEGY 3: MAIN/PRODUCTION DEPLOYMENT ---
      - name: Deploy to Production Environment (AWS S3 staging/prod)
        if: github.ref_name == 'main'
        run: |
          echo "Deploying application archive to Production AWS S3..."
          aws s3 cp "target/${{ steps.ver.outputs.jar_name }}" "s3://${{ env.S3_BUCKET }}/prod/archives/${{ env.APP_NAME }}-prod-latest.jar"

      # --- POST-DEPLOYMENT QA: PLAYWRIGHT INTEGRATION ---
      - name: Install Node.js for Playwright E2E Tests
        uses: actions/setup-node@v4
        with:
          node-version: lts/*

      - name: Install Playwright Dependencies
        run: |
          npm init -y
          npm install @playwright/test
          npx playwright install --with-deps

      - name: Run Playwright Tests against Environment
        run: |
          if [ "${{ github.ref_name }}" = "test" ]; then
            TARGET_URL="https://test-saayam.netlify.app"
          elif [ "${{ github.ref_name }}" = "dev" ]; then
            TARGET_URL="https://dev-saayam.netlify.app"
          else
            TARGET_URL="https://test.help-for-everyone.org/"
          fi
          echo "Running E2E validation tests against $TARGET_URL"

      # Safe cleanup mechanism for old archives (Keeps only last 3 versions in Dev)
      - name: Keep only last 3 versioned archives
        if: github.ref_name == 'dev'
        shell: bash
        run: |
          set -euo pipefail
          BUCKET="${{ env.S3_BUCKET }}"
          PREFIX="dev/archives/"
          KEYS=$(aws s3api list-objects-v2 --bucket "$BUCKET" --prefix "$PREFIX" --query 'reverse(sort_by(Contents[?ends_with(Key, `.jar`)], &LastModified))[].Key' --output text)
          if [ -z "$KEYS" ] || [ "$KEYS" = "None" ]; then exit 0; fi
          KEYS_NL=$(echo "$KEYS" | tr '\t' '\n')
          TO_DELETE=$(echo "$KEYS_NL" | tail -n +4)
          if [ -n "$TO_DELETE" ]; then
            while IFS= read -r key; do 
              [ -z "$key" ] && continue
              aws s3 rm "s3://$BUCKET/$key" || true
            done <<< "$TO_DELETE"
          fi
